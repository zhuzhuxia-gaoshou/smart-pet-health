# 复制本文件为 .env 并填入真实 Key（.env 不进 git）
# 两个 Key 都未配置时，系统自动进入"示例回答"模式，全流程仍可演示

# ── DeepSeek（推荐，原生 function calling）──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # 可选，默认官方端点

# ── 阿里通义千问（备选，文本 ReAct）──
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# QWEN_MODEL=qwen-plus
